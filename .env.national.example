# The national node: owns the dictionary, receives events, routes referrals.
# cp .env.national.example .env

SISLAB_SYNC_MODE=national
SISLAB_SYNC_FACILITY_CODE=NATIONAL

# Set to false on a production node reached over plain HTTP, with no reverse
# proxy terminating TLS in front of it. Only read in RAILS_ENV=production.
SISLAB_SYNC_TLS_TERMINATED=true

RAILS_ENV=development
APP_PORT=3100

# The server's own MySQL, through its socket (see docker-compose.yml). The
# database is created on first boot, so the user needs CREATE on it.
DATABASE_NAME=sislab_sync_national_development
DATABASE_USER=root
DATABASE_PASSWORD=
# MYSQL_SOCKET_DIR=/var/run/mysqld

# Docker Desktop, whose VM cannot see the host socket: over TCP instead.
# DATABASE_HOST=host.docker.internal
# DATABASE_SOCKET=

# Or a MySQL in a container, on a machine that has none of its own:
# COMPOSE_PROFILES=mysql
# DATABASE_HOST=mysql
# DATABASE_SOCKET=
# DATABASE_PASSWORD=sislab
